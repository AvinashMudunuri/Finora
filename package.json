{
  "name": "finora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e-all-current": "tsc -b && vite build --mode e2e-all-current",
    "build:e2e-overdue": "tsc -b && vite build --mode e2e-overdue",
    "build:e2e-nw-decreased": "tsc -b && vite build --mode e2e-nw-decreased",
    "build:e2e-nw-unchanged": "tsc -b && vite build --mode e2e-nw-unchanged",
    "build:e2e-high-util": "tsc -b && vite build --mode e2e-high-util",
    "build:e2e-no-attention": "tsc -b && vite build --mode e2e-no-attention",
    "preview": "vite preview",
    "preview:e2e-high-util": "vite preview --outDir dist-e2e-high-util",
    "preview:e2e-no-attention": "vite preview --outDir dist-e2e-no-attention",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "volta": {
    "node": "22.14.0"
  }
}
