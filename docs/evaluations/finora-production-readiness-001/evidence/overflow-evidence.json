{
  "method": "document.documentElement.scrollWidth - clientWidth; body.scrollWidth - body.clientWidth",
  "viewports": [
    { "width": 1440, "height": 900, "overflow": 0, "nav": "desktop" },
    { "width": 1024, "height": 768, "overflow": 0, "nav": "desktop" },
    { "width": 768, "height": 1024, "overflow": 0, "nav": "desktop" },
    { "width": 414, "height": 896, "overflow": 0, "nav": "mobile-menu" },
    { "width": 390, "height": 844, "overflow": 0, "nav": "mobile-menu" },
    { "width": 375, "height": 812, "overflow": 0, "nav": "mobile-menu" },
    { "width": 360, "height": 800, "overflow": 0, "nav": "mobile-menu" },
    {
      "width": 320,
      "height": 800,
      "htmlOverflow": 15,
      "bodyOverflow": 0,
      "nav": "mobile-menu",
      "note": "15px is the classic scrollbar gutter (320 vs 305 clientWidth), not destination overflow. Same classification as #48."
    }
  ]
}
